{
	"name": "kantan-ui",
	"version": "0.0.1",
	"description": "A Streamlit alternative framework that depends only on Web standards and Hono",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun && bun run build:types",
		"build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"audit": "npm audit --audit-level=moderate",
		"ci": "bun run lint && bun run build && bun run test:coverage"
	},
	"keywords": ["ui", "framework", "hono", "streamlit", "web"],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watany-dev/kantan-ui.git"
	},
	"bugs": {
		"url": "https://github.com/watany-dev/kantan-ui/issues"
	},
	"homepage": "https://github.com/watany-dev/kantan-ui#readme",
	"dependencies": {
		"hono": "^4.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@playwright/test": "^1.49.0",
		"@types/bun": "^1.1.0",
		"@vitest/coverage-v8": "^2.1.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	},
	"engines": {
		"node": ">=18"
	}
}
