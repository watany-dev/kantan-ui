{
	"name": "kantan-ui",
	"version": "0.0.1",
	"description": "A Streamlit alternative framework that depends only on Web standards and Hono",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./serve": {
			"types": "./dist/serve.d.ts",
			"import": "./dist/serve.js"
		},
		"./lambda": {
			"types": "./dist/lambda.d.ts",
			"import": "./dist/lambda.js"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare.d.ts",
			"import": "./dist/cloudflare.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bun run --watch src/server.ts",
		"build": "bun build src/index.ts src/serve.ts src/lambda.ts src/cloudflare.ts --outdir dist --target node --format esm --external @hono/node-server --external @hono/node-ws && bun run build:types",
		"build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
		"start:dist": "bun run scripts/serve-dist.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"bench": "vitest bench",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write .",
		"format": "npx @biomejs/biome format --write .",
		"check": "npx @biomejs/biome check --write .",
		"audit": "npm audit --audit-level=moderate",
		"dead-code": "knip",
		"ci": "bun run lint && bun run build && bun run test:coverage && bun run test:e2e"
	},
	"keywords": [
		"ui",
		"framework",
		"hono",
		"streamlit",
		"web"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watany-dev/kantan-ui.git"
	},
	"bugs": {
		"url": "https://github.com/watany-dev/kantan-ui/issues"
	},
	"homepage": "https://github.com/watany-dev/kantan-ui#readme",
	"dependencies": {
		"hono": "^4.11.7"
	},
	"peerDependencies": {
		"@hono/node-server": ">=1.13.0",
		"@hono/node-ws": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@hono/node-server": {
			"optional": true
		},
		"@hono/node-ws": {
			"optional": true
		}
	},
	"devDependencies": {
		"@hono/node-server": "^2.0.6",
		"@hono/node-ws": "^1.0.0",
		"@biomejs/biome": "^2.3.11",
		"@playwright/test": "^1.50.0",
		"@types/bun": "^1.1.0",
		"@types/jsdom": "^28.0.1",
		"@types/node": "^25.0.3",
		"@vitest/coverage-istanbul": "^4.0.16",
		"fast-check": "^4.5.3",
		"jsdom": "^29.0.1",
		"knip": "^5.0.0",
		"typescript": "^6.0.2",
		"vitest": "^4.0.16"
	},
	"engines": {
		"node": ">=18"
	}
}
