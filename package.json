{
	"name": "kantan-ui",
	"version": "0.0.1",
	"description": "A Streamlit alternative framework that depends only on Web standards and Hono",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bun run --watch src/server.ts",
		"build": "bun build src/index.ts --outdir dist --target bun && bun run build:types",
		"build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"bench": "vitest bench",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write .",
		"format": "npx @biomejs/biome format --write .",
		"check": "npx @biomejs/biome check --write .",
		"audit": "npm audit --audit-level=moderate",
		"dead-code": "knip",
		"ci": "bun run lint && bun run build && bun run test:coverage"
	},
	"keywords": [
		"ui",
		"framework",
		"hono",
		"streamlit",
		"web"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watany-dev/kantan-ui.git"
	},
	"bugs": {
		"url": "https://github.com/watany-dev/kantan-ui/issues"
	},
	"homepage": "https://github.com/watany-dev/kantan-ui#readme",
	"dependencies": {
		"hono": "^4.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"knip": "^5.0.0",
		"@playwright/test": "^1.50.0",
		"@types/bun": "^1.1.0",
		"@vitest/coverage-istanbul": "^2.1.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	},
	"engines": {
		"node": ">=18"
	}
}
