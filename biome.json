{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"assist": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"recommended": true,
				"noExcessiveCognitiveComplexity": "warn",
				"noUselessFragments": "error",
				"useOptionalChain": "error",
				"useLiteralKeys": "off"
			},
			"correctness": {
				"recommended": true,
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"recommended": true,
				"noNonNullAssertion": "error",
				"useConst": "error",
				"useTemplate": "error"
			},
			"suspicious": {
				"recommended": true,
				"noExplicitAny": "error",
				"useAwait": "error"
			},
			"security": {
				"recommended": true
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/playwright-report",
			"!**/test-results",
			"!**/coverage"
		]
	}
}
